# --- Sanity Context MCP (Path One) ---------------------------------------
# The full Context MCP endpoint URL. Shape:
#   https://api.sanity.io/v1/context/organizations/YOUR_ORG_ID/mcp/YOUR_ENDPOINT_NAME
# For Knowledge Base mode you can force it and name the KB(s) via query params:
#   ...?mode=knowledge_base&knowledgeBases=kbXXXXXXXX
# (KB ids begin with "kb"; comma-separate several.)
# OPTIONAL: leave blank to run the credential-free public-GROQ path instead
# (python -m agent.reconcile_offline and python -m agent.baseline need no token).
SANITY_CONTEXT_MCP_URL=

# An ORGANIZATION API token with Context Viewer permission.
# Create at Manage > (org) > API > Tokens  (ORG level, not project level).
# Keep this server-side. A project token returns 403 contextGrantRequired.
# Only required for the Context MCP path (the LLM agent in Knowledge Base mode).
SANITY_ORGANIZATION_TOKEN=

# The hard-requirement identifier for the submission post (project id OR public dataset url).
SANITY_PROJECT_ID=0q5ohtvv
SANITY_ORGANIZATION_ID=
SANITY_DATASET=production

# --- Model (Amazon Bedrock) ----------------------------------------------
# The agent runs on Amazon Nova Pro via Bedrock Converse. Use standard AWS
# credentials (env vars, shared config, or an instance role) with bedrock:InvokeModel
# and read-only Describe/Get/List for the live cross-check. No model API key needed.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0
